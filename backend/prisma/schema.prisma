generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Protocol {
  id                          String    @id @default(uuid())
  sponsorProtocolIdentifier   String    @unique @map("sponsor_protocol_identifier") @db.VarChar(100)
  fullTitle                   String    @map("full_title") @db.Text
  shortTitle                  String?   @map("short_title") @db.VarChar(250)
  protocolVersion             String    @map("protocol_version") @db.VarChar(50)
  protocolDate                DateTime  @map("protocol_date") @db.Date
  
  // Amendment tracking
  originalProtocolIndicator   Boolean   @default(true) @map("original_protocol_indicator")
  protocolAmendmentNumber     String?   @map("protocol_amendment_number") @db.VarChar(20)
  amendmentScope              String?   @map("amendment_scope") @db.VarChar(50)
  
  // Trial basic info
  trialPhase                  String?   @map("trial_phase") @db.VarChar(50)
  indication                  String?   @map("indication") @db.Text
  studyType                   String    @default("Interventional") @map("study_type") @db.VarChar(50)
  
  // Status tracking
  protocolStatus              String    @default("draft") @map("protocol_status") @db.VarChar(50)
  completenessPercentage      Float?    @default(0) @map("completeness_percentage")
  
  // USDM storage
  usdmJson                    Json?     @map("usdm_json")
  
  // Metadata
  createdBy                   String    @map("created_by") @db.VarChar(100)
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedBy                   String?   @map("updated_by") @db.VarChar(100)
  updatedAt                   DateTime  @updatedAt @map("updated_at")
  
  // Relations
  sections                    ProtocolSection[]
  objectives                  Objective[]
  eligibilityCriteria         EligibilityCriterion[]
  interventions               Intervention[]
  validationResults           ValidationResult[]
  
  @@map("protocols")
}

model ProtocolSection {
  id              String    @id @default(uuid())
  protocolId      String    @map("protocol_id")
  sectionNumber   String    @map("section_number") @db.VarChar(10)
  sectionTitle    String    @map("section_title") @db.VarChar(200)
  sectionType     String    @map("section_type") @db.VarChar(50)
  orderIndex      Int       @map("order_index")
  
  // Content stored as structured JSON
  content         Json      @default("{}")
  isComplete      Boolean   @default(false) @map("is_complete")

  // Metadata
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  protocol        Protocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)

  @@unique([protocolId, sectionNumber])
  @@map("protocol_sections")
}

model Objective {
  id              String    @id @default(uuid())
  protocolId      String    @map("protocol_id")
  objectiveType   String    @map("objective_type") @db.VarChar(20)
  orderIndex      Int       @map("order_index")
  objectiveText   String    @map("objective_text") @db.Text
  
  // Estimand (ICH E9 R1)
  estimand        Json?
  rationale       String?   @db.Text
  
  // Metadata
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  protocol        Protocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  
  @@map("objectives")
}

model EligibilityCriterion {
  id              String    @id @default(uuid())
  protocolId      String    @map("protocol_id")
  criterionType   String    @map("criterion_type") @db.VarChar(10)
  criterionNumber String    @map("criterion_number") @db.VarChar(10)
  criterionText   String    @map("criterion_text") @db.Text
  orderIndex      Int       @map("order_index")
  
  // Metadata
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  // Relations
  protocol        Protocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  
  @@map("eligibility_criteria")
}

model Intervention {
  id                      String    @id @default(uuid())
  protocolId              String    @map("protocol_id")
  interventionType        String    @map("intervention_type") @db.VarChar(50)
  productName             String    @map("product_name") @db.VarChar(200)
  dosageForm              String?   @map("dosage_form") @db.VarChar(100)
  routeOfAdministration   String?   @map("route_of_administration") @db.VarChar(100)
  dose                    String?   @db.VarChar(50)
  doseUnit                String?   @map("dose_unit") @db.VarChar(20)
  frequency               String?   @db.VarChar(100)
  duration                String?   @db.VarChar(100)
  rationale               String?   @db.Text
  orderIndex              Int       @map("order_index")
  
  // Metadata
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  
  // Relations
  protocol                Protocol  @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  
  @@map("interventions")
}

model ControlledTerminology {
  id              String    @id @default(uuid())
  domain          String    @db.VarChar(50)
  code            String    @db.VarChar(50)
  displayName     String    @map("display_name") @db.VarChar(200)
  definition      String?   @db.Text
  parentCode      String?   @map("parent_code") @db.VarChar(50)
  isActive        Boolean   @default(true) @map("is_active")
  
  // Metadata
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  
  @@unique([domain, code])
  @@map("controlled_terminology")
}

model ValidationRule {
  id          String   @id @default(uuid())
  ruleId      String   @unique @map("rule_id") @db.VarChar(50)
  ruleName    String   @map("rule_name") @db.VarChar(200)
  category    String   @db.VarChar(50) // "m11_conformance", "cross_section", "gcp", "india_specific"
  severity    String   @db.VarChar(20) // "error", "warning", "info"
  description String   @db.Text
  section     String?  @db.VarChar(10) // M11 section number this rule applies to
  isActive    Boolean  @default(true) @map("is_active")
  
  // Metadata
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  @@map("validation_rules")
}

model ValidationResult {
  id                String   @id @default(uuid())
  protocolId        String   @map("protocol_id")
  validationDate    DateTime @default(now()) @map("validation_date")
  overallStatus     String   @map("overall_status") @db.VarChar(50) // "valid", "invalid", "valid_with_warnings"
  totalIssues       Int      @default(0) @map("total_issues")
  errorCount        Int      @default(0) @map("error_count")
  warningCount      Int      @default(0) @map("warning_count")
  
  // Results as JSON
  results           Json     // Array of validation issues
  sectionStatus     Json     @map("section_status") // Status per section
  
  // Relations
  protocol          Protocol @relation(fields: [protocolId], references: [id], onDelete: Cascade)
  
  @@map("validation_results")
}

// Authentication & User Management Models

model User {
  id                String    @id @default(uuid())
  email             String    @unique @db.VarChar(255)
  passwordHash      String    @map("password_hash") @db.VarChar(255)
  firstName         String    @map("first_name") @db.VarChar(100)
  lastName          String    @map("last_name") @db.VarChar(100)
  title             String?   @db.VarChar(50) // Dr., Prof., etc.
  specialty         String?   @db.VarChar(100) // Cardiology, Oncology, etc.
  institution       String?   @db.VarChar(255)
  licenseNumber     String?   @map("license_number") @db.VarChar(100)
  phone             String?   @db.VarChar(20)
  country           String    @default("India") @db.VarChar(100)
  state             String?   @db.VarChar(100)
  city              String?   @db.VarChar(100)
  role              String    @default("researcher") @db.VarChar(50) // researcher, admin, viewer
  emailVerified     Boolean   @default(false) @map("email_verified")
  profileImageUrl   String?   @map("profile_image_url") @db.Text
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  lastLoginAt       DateTime? @map("last_login_at")
  isActive          Boolean   @default(true) @map("is_active")
  
  // Relations
  sessions                    Session[]
  notifications               Notification[]
  preferences                 UserPreferences?
  passwordResetTokens         PasswordResetToken[]
  emailVerificationTokens     EmailVerificationToken[]
  agentSessions               AgentSession[]
  
  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  token         String    @unique @db.VarChar(500)
  refreshToken  String?   @unique @map("refresh_token") @db.VarChar(500)
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  ipAddress     String?   @map("ip_address") @db.VarChar(45)
  userAgent     String?   @map("user_agent") @db.Text
  isActive      Boolean   @default(true) @map("is_active")
  
  // Relations
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([userId])
  @@map("sessions")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String    @db.VarChar(50) // protocol_update, trial_match, system, comment, mention
  title       String    @db.VarChar(255)
  message     String    @db.Text
  link        String?   @db.VarChar(500) // URL to navigate when clicked
  isRead      Boolean   @default(false) @map("is_read")
  priority    String    @default("normal") @db.VarChar(20) // low, normal, high, urgent
  createdAt   DateTime  @default(now()) @map("created_at")
  readAt      DateTime? @map("read_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
}

model UserPreferences {
  id                  String    @id @default(uuid())
  userId              String    @unique @map("user_id")
  emailNotifications  Boolean   @default(true) @map("email_notifications")
  pushNotifications   Boolean   @default(true) @map("push_notifications")
  trialAlerts         Boolean   @default(true) @map("trial_alerts")
  protocolUpdates     Boolean   @default(true) @map("protocol_updates")
  weeklyDigest        Boolean   @default(true) @map("weekly_digest")
  theme               String    @default("light") @db.VarChar(20) // light, dark, auto
  language            String    @default("en") @db.VarChar(10)
  timezone            String    @default("Asia/Kolkata") @db.VarChar(50)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  
  // Relations
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_preferences")
}

model PasswordResetToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  token       String    @unique @db.VarChar(500)
  expiresAt   DateTime  @map("expires_at")
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  
  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  token       String    @unique @db.VarChar(500)
  expiresAt   DateTime  @map("expires_at")
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("email_verification_tokens")
}

// ── EDC / Sprint 7 ─────────────────────────────────────────────────────────────

model CrfForm {
  id          String     @id @default(uuid())
  name        String     @db.VarChar(200)
  orderIndex  Int        @default(0) @map("order_index")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  fields      CrfField[]
  entries     EdcEntry[]

  @@map("crf_forms")
}

model CrfField {
  id         String   @id @default(uuid())
  formId     String   @map("form_id")
  type       String   @db.VarChar(20)
  label      String   @db.VarChar(300)
  required   Boolean  @default(false)
  options    String[]
  orderIndex Int      @default(0) @map("order_index")

  form       CrfForm  @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@map("crf_fields")
}

model EdcPatient {
  id         String     @id @default(uuid())
  subjectId  String     @unique @map("subject_id") @db.VarChar(50)
  site       String     @db.VarChar(200)
  status     String     @default("screening") @db.VarChar(20)
  enrolledAt DateTime   @default(now()) @map("enrolled_at")

  entries    EdcEntry[]

  @@map("edc_patients")
}

model EdcEntry {
  id          String    @id @default(uuid())
  patientId   String    @map("patient_id")
  formId      String    @map("form_id")
  visitDate   String    @db.VarChar(20)
  data        Json
  submittedAt DateTime  @default(now()) @map("submitted_at")
  signerName  String?   @map("signer_name") @db.VarChar(200)
  signerRole  String?   @map("signer_role") @db.VarChar(100)
  signedAt    DateTime? @map("signed_at")

  patient     EdcPatient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  form        CrfForm    @relation(fields: [formId], references: [id])

  @@map("edc_entries")
}

model EdcAuditLog {
  id        String   @id @default(uuid())
  timestamp DateTime @default(now())
  action    String   @db.VarChar(50)
  entity    String   @db.VarChar(200)
  detail    String   @db.Text

  @@map("edc_audit_logs")
}

// ── Agentic AI ────────────────────────────────────────────────────────────────

model AgentSession {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  tab       String         @db.VarChar(30)   // research | match | regulatory | edc | analysis | protocol
  title     String         @db.VarChar(300)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  messages  AgentMessage[]
  artifacts AgentArtifact[]
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tab])
  @@map("agent_sessions")
}

model AgentMessage {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  role      String   @db.VarChar(20)   // user | assistant | tool
  content   String   @db.Text
  toolName  String?  @map("tool_name") @db.VarChar(100)
  toolInput Json?    @map("tool_input")
  createdAt DateTime @default(now()) @map("created_at")

  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("agent_messages")
}

model AgentArtifact {
  id        String   @id @default(uuid())
  sessionId String   @map("session_id")
  name      String   @db.VarChar(200)
  type      String   @db.VarChar(30)   // markdown | pdf | json | csv
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  session   AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("agent_artifacts")
}

// GCP-compliant append-only audit trail for every agent action
// Required for 21 CFR Part 11 / ICH E6(R2) — never updated or deleted
model AgentAuditLog {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  sessionId  String?  @map("session_id")
  action     String   @db.VarChar(50)   // PLAN | TOOL_CALL | SYNTHESIS | ARTIFACT | ERROR
  toolName   String?  @map("tool_name") @db.VarChar(100)
  queryHash  String?  @map("query_hash") @db.VarChar(16)  // first 16 chars of SHA-256
  status     String   @db.VarChar(20)   // ok | error
  durationMs Int?     @map("duration_ms")
  meta       Json?                       // extra structured data (count, size, etc.)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@map("agent_audit_logs")
}