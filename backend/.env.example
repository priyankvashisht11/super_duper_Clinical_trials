DATABASE_URL="postgresql://username:password@localhost:5432/protocol_builder?schema=public"
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="CHANGE_ME_64_char_hex_secret"

# AI Integration - Perplexity API
PERPLEXITY_API_KEY="your_perplexity_api_key_here"
PERPLEXITY_API_URL="https://api.perplexity.ai/chat/completions"

# Optional — Anthropic Claude; agent orchestrator auto-switches to this over Perplexity when set
ANTHROPIC_API_KEY=""

# Email (password reset / verification) — provider-agnostic SMTP, works with SendGrid,
# SES, Mailgun, Postmark, Gmail, etc. If SMTP_HOST is unset, emails are logged to the
# console instead of sent, so auth flows still work without any mail server in dev.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="NexTrial <no-reply@nextrial.local>"
