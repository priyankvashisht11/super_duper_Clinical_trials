# ─────────────────────────────────────────────────────────────────────────────
# NexTrial — Production Environment Variables
# Copy this to .env on your server: cp .env.production.example .env
# Then fill in every value. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domain (no https://, no trailing slash) ───────────────────────────────────
DOMAIN=yourdomain.com
FRONTEND_URL=https://yourdomain.com
NODE_ENV=production

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=clinical_trials
POSTGRES_USER=clinical_user
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_64_char_hex_secret
JWT_REFRESH_SECRET=CHANGE_ME_different_64_char_hex_secret

# ── AI APIs ───────────────────────────────────────────────────────────────────
PERPLEXITY_API_KEY=pplx-...
ANTHROPIC_API_KEY=sk-ant-...

# ── n8n ───────────────────────────────────────────────────────────────────────
N8N_USER=admin
N8N_PASSWORD=CHANGE_ME_n8n_password

# ── Backblaze B2 (for automated DB backups) ───────────────────────────────────
B2_KEY_ID=CHANGE_ME
B2_APPLICATION_KEY=CHANGE_ME
B2_BUCKET_NAME=nextrial-backups
